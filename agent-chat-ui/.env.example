# SuperAIDB Configuration

# Management API (data-engine) Configuration
# The frontend proxies all management requests through the server-side route
# /api/mgmt/* (src/app/api/mgmt/[..._path]/route.ts), which attaches X-API-Key.
# Do NOT prefix these with "NEXT_PUBLIC_" — the key must stay server-side only.
# Optional. Defaults to http://localhost:2025.
MGMT_API_URL=http://localhost:2025
# Required. Must match API_KEY configured in the data-engine backend.
MGMT_API_KEY=
