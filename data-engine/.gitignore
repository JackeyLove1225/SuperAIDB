config/pending_approvals.json
config/escalation.json
config/settlement_results.json

# daemon 运行时文件（每启动重写）
config/runtime/

# 文件契约锁（运行态工件，永不进仓）
config/*.lock

# 运行时文件（不入库）
config/unrecognized_pool.json

