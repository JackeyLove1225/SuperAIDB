# ===== AI 配置 =====
# AI 接口密钥（必填，启动时校验）
AI_API_KEY=your_api_key_here
# AI 接口地址（默认 https://api.deepseek.com）
AI_BASE_URL=https://api.deepseek.com
# AI 模型名（默认 deepseek-chat）
AI_MODEL=deepseek-chat

# ===== 数据库配置 =====
# 数据库类型：sqlite / mysql（默认 sqlite）
DB_TYPE=sqlite
# SQLite 存储路径（默认 ./db/data_engine.db）
SQLITE_DB_PATH=./db/data_engine.db

# MySQL 配置（DB_TYPE=mysql 时生效）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=superaidb

# ===== 图数据库（表关系可视化图层）=====
# 嵌入式 Ladybug，进程内运行、零独立服务，一般无需配置
# LADYBUG_DB_PATH=./db/schema_graph.lbdb

# ===== API 认证 =====
# 是否开启 API Key 校验（默认 false，本地使用；部署到服务器时开启）
API_KEY_ENABLED=false
# API Key（API_KEY_ENABLED=true 时必填）
API_KEY=
# 开放注册（默认 true，桌面端自助建号；部署到服务器/暴露网络时改 false，
# 关闭后仅 admin 可创建账号）
AUTH_REGISTER_ENABLED=true
# Token 签名密钥（留空则首次启动自动生成并追加到本文件）
AUTH_TOKEN_SECRET=

# ===== 行业模式 =====
# engineering / medical / finance（默认 construction_engineering）
INDUSTRY=construction_engineering

# ===== 单步模式 AI 开关 =====
# P1 语义解析 AI 开关（默认 false，走 LangGraph 结构化标签透传）
P1_AI_ENABLED=false
# FC（Function Calling）AI 开关（默认 false，直接用 structured_args 构造参数）
FC_AI_ENABLED=false

# ===== 存储与向量库 =====
# 上传文件目录（默认 ./uploads）
UPLOAD_DIR=./uploads
# 向量库类型（默认 chroma；pgvector 为预留，尚未实现）
VECTOR_STORE_TYPE=chroma
# Chroma 存储路径（默认 ./db/chroma）
CHROMA_PATH=./db/chroma
# Embedding 模型（默认留空 = Chroma 内置 onnxruntime 版 all-MiniLM-L6-v2，英文向）
# 中文场景建议配置 sentence-transformers 模型，如 BAAI/bge-small-zh-v1.5；
# 需先执行 pip install sentence-transformers（可选依赖，未安装时自动降级回内置默认模型）。
# 注意：无论内置模型还是自定义模型，首次使用都需联网下载模型权重——
# 离线/客户环境需预置模型缓存（内置模型缓存于 ~/.cache/chroma/onnx_models，
# sentence-transformers 模型缓存于 HuggingFace 缓存目录，可用 HF_HOME 指定后打包分发）。
EMBEDDING_MODEL=
# Embedding 运行设备（可选，如 cpu / cuda；留空自动选择）
EMBEDDING_DEVICE=

# ===== 体系B：深度研究配置 =====
# Web 搜索开关（默认 true）
WEB_SEARCH_ENABLED=true
# Tavily 搜索 API 密钥（Web 搜索需要）
TAVILY_API_KEY=
# 网页抓取超时秒数（默认 15）
WEB_FETCH_TIMEOUT=15
# 网页抓取最大字符数（默认 4000）
WEB_FETCH_MAX_CHARS=4000

# ===== 文件工具 =====
# 文件工具开关（默认 true）
FILE_TOOLS_ENABLED=true
# 写文件权限——永久关闭，预防日后需求（代码保留但不启用）
FILE_WRITE_ENABLED=false
# 文件访问根目录（默认项目根目录，一般无需配置）
# FILE_ACCESS_ROOT=

# ===== OODA 循环参数 =====
# 单目标最大循环轮数（默认 5）
OODA_MAX_ROUNDS_PER_GOAL=5
# 最大目标数（默认 8）
OODA_MAX_GOALS=8
# 全部目标累计最大轮数（默认 20）
OODA_MAX_TOTAL_ROUNDS=20

# 数据库加密：true（默认，明文库自动迁移为密文）/ false（不推荐）
DB_ENCRYPT=true

# ===== OCR 云服务（图片/扫描件文字识别）=====
# 默认走 PaddleOCR 云（PaddleOCR-VL）；注意：启用后扫描件内容会发送到云端识别——
# 数据敏感场景请自行部署/替换 OCR 端点（OCR_API_URL），或无 token 时扫描件如实降级不识别
OCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
OCR_API_TOKEN=
OCR_MODEL=PaddleOCR-VL-1.6
OCR_TIMEOUT=300
